[Unit]
Description=Limpieza de PDF vencidos de indicadores de Calidad
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=sgc
Group=sgc
WorkingDirectory=/opt/calidad/app
ExecStart=/usr/bin/docker compose --env-file /srv/calidad-platform/config/.env.server.local -f /opt/calidad/app/deploy/docker/docker-compose.local.yml exec -T backend python manage.py purge_expired_indicator_report_files
